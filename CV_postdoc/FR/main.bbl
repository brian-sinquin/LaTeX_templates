    \strng{namehash}{SB+1}
    \strng{fullhash}{SBRMAMVM1}
    \field{labelnamesource}{author}
    \field{labeltitlesource}{title}
    \field{sortinit}{S}
    \field{sortinithash}{S}
    \field{abstract}{%
    We report the generation of an optical pulse train with a 10 GHz
  repetition rate in a dual loop direct-modulation optoelectronic oscillator
  (OEO). Pulse generation is achieved using nonlinear compression in the OEO
  5-km-long optical delay line. 3 ps pulses with a timing jitter of 13 fs are
  reported, while the OEO maintains a phase noise of −133dBc/Hz at 10 kHz
  from the carrier. Two architectures are compared experimentally and
  theoretically. A frequency comb with a 1.2 THz linewidth at −30dB is
  generated.%
    }
    \verb{doi}
    \verb 10.1364/JOSAB.529629
    \endverb
    \field{issue}{9}
    \field{pages}{1921}
    \field{title}{Direct-modulation optoelectronic oscillator for optical pulse
  and frequency comb generation}
    \field{volume}{41}
    \field{journaltitle}{Journal of the Optical Society of America B}
    \field{month}{09}
    \field{year}{2024}
  \endentry

