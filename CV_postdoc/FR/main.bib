@article{Sinquin2024,
   abstract = {We report the generation of an optical pulse train with a 10 GHz repetition rate in a dual loop direct-modulation optoelectronic oscillator (OEO). Pulse generation is achieved using nonlinear compression in the OEO 5-km-long optical delay line. 3 ps pulses with a timing jitter of 13 fs are reported, while the OEO maintains a phase noise of −133dBc/Hz at 10 kHz from the carrier. Two architectures are compared experimentally and theoretically. A frequency comb with a 1.2 THz linewidth at −30dB is generated.},
   author = {Brian Sinquin and Marco Romanelli and Mehdi Alouini and Marc Vallet},
   doi = {10.1364/JOSAB.529629},
 
   issue = {9},
   journal = {Journal of the Optical Society of America B},
   keywords = {Nonlinear optical fibers,Optical delay lines,Optical oscillators,Phase modulation,Phase noise,Photonic crystal fibers},
   month = {9},
   pages = {1921},
   publisher = {Optica Publishing Group},
   title = {Direct-modulation optoelectronic oscillator for optical pulse and frequency comb generation},
   volume = {41},
   year = {2024}
}
@article{Sinquin2023c,
   abstract = { We show that the method of complete optical field reconstruction introduced by Debeau et al. [  Opt. Lett. 23 , 1784 ( 1998 ) 10.1364/OL.23.001784  ] allows a precise determination of the linewidth enhancement factor (LEF) of semiconductor lasers. We determine experimentally the LEF with 3% uncertainty. The method is rather simple and reliable, and is of interest in the context of microwave photonics. While particularly adapted to actively modulated devices, the proposed approach can in principle be applied to any laser exhibiting a time-periodic behavior. },
   author = {Brian Sinquin and Marco Romanelli},
   doi = {10.1364/OL.483776},

   issue = {4},
   journal = {Optics Letters},
   keywords = {Distributed feedback lasers,Microwave photonics,Optical fields,Semiconductor lasers,Semiconductor optical amplifiers,Vertical cavity surface emitting lasers},
   month = {2},
   pages = {863},
   pmid = {36790960},
   publisher = {Optica Publishing Group},
   title = {Determination of the linewidth enhancement factor of semiconductor lasers by complete optical field reconstruction},
   volume = {48},
   year = {2023}
}

@article{Sinquin2025b,
   abstract = {We report the implementation of a single-pass tilt-locking stabilization scheme in an opto-electronic oscillator using a high-finesse Fabry-Perot as photonic filter. A table-top setup leads to a phase noise level of −80 dBc/Hz at 1 kHz offset from a 6 GHz carrier and a Allan deviation measurement of 3×10−10 for 1 s integration time. Future improvements leading to a compact fiber-free OEO are discussed.},
   author = {Brian Sinquin and Marc Vallet and Marco Romanelli and Mehdi Alouini},
   doi = {10.1109/LPT.2025.3544428},

   issue = {6},
   journal = {IEEE Photonics Technology Letters},
   keywords = {Optoelectronic oscillator,high-finesse cavity,tilt-locking},
   month = {3},
   pages = {321-324},
   publisher = {Institute of Electrical and Electronics Engineers Inc.},
   title = {Optoelectronic Oscillator Combining a High-Finesse Cavity and Tilt-Locking Stabilization},
   volume = {37},
   year = {2025}
}